\b 9. Como subir em outro PC\b0\par
Comandos base:\par
python -m venv .venv\par
.venv\Scripts\Activate.ps1\par
pip install -r requirements.txt\par
Copy-Item .env.example .env\par
\par
Backend:\par
cd backend\par
python run.py\par
\par
Desktop:\par
python desktop/main.py\par
\par
Web mobile:\par
cd web_app\par
python -m http.server 5500\par
\par
