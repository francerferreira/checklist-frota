SECRET_KEY=troque-esta-chave-em-producao
CHECKLIST_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/checklist_frota
# SQLite e permitido somente em ambiente local controlado.
CHECKLIST_ALLOW_SQLITE=0
CHECKLIST_LEGACY_LOCAL_BOOTSTRAP=0
# Protecao de concorrencia para o SQLite local. WAL permite leitores durante gravacoes.
SQLITE_BUSY_TIMEOUT_MS=15000
SQLITE_JOURNAL_MODE=WAL
TOKEN_MAX_AGE_SECONDS=28800
CORS_STRICT_MODE=true
CORS_ALLOWED_ORIGINS=https://checklist-web-uej3.onrender.com,http://127.0.0.1:5500,http://localhost:5500
# Use somente no primeiro bootstrap de uma base vazia; nunca versionar a senha.
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
AUTOMATION_JOB_TOKEN=defina-uma-chave-exclusiva-para-o-agendamento
API_BASE_URL=http://127.0.0.1:5000
INVENTORY_FILE=C:/Users/francer.ferreira/OneDrive - Chibatao Navegacao e Comercio Ltda/Documentos/INVENTARIO FROTA 2026.xlsx
WASH_CONTROL_FILE=
PORTUARY_ONLY_MODE=false

# Render + Supabase
# No Render, preencha DATABASE_URL com a connection string do Supabase em formato SQLAlchemy:
# postgresql+psycopg://postgres.xxx:SENHA@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-somente-no-backend
SUPABASE_STORAGE_BUCKET=evidencias
STORAGE_BACKEND=supabase

# Limites do plano gratis usados pelo monitor do sistema.
FREE_DB_LIMIT_MB=500
FREE_STORAGE_LIMIT_MB=1024
BACKUP_FOLDER=backend/backups
